#.ENV.EXAMPLE
SECRET_KEY=troque-essa-chave-por-uma-grande
DATABASE_URL=seu_link_de_conexão_com_banco_de_dados
PORT=8080
ADMIN_PASSWORD=troque-a-senha-do-admin

APP_ENV=development
DEBUG=False

# ============================
# Alertas de seguranca
# ============================
ALERTAS_HABILITADOS=true
ALERTA_FUSO_HORARIO=America/Sao_Paulo

# Brute force de login
ALERTA_LOGIN_FALHAS_LIMITE=3
ALERTA_LOGIN_FALHAS_JANELA_MIN=5
ALERTA_LOGIN_FALHAS_COOLDOWN_MIN=2
ALERTA_LOGIN_BLOQUEIO_HABILITADO=true
ALERTA_LOGIN_BLOQUEIO_MIN=1
ALERTA_LOGIN_BLOQUEAR_LOCALHOST=false

# Exportacao massiva
ALERTA_EXPORTACAO_LIMITE=3
ALERTA_EXPORTACAO_JANELA_MIN=10
ALERTA_EXPORTACAO_COOLDOWN_MIN=20

# Superadmin fora de horario
ALERTA_SUPERADMIN_HORA_INICIO=8
ALERTA_SUPERADMIN_HORA_FIM=18
ALERTA_SUPERADMIN_COOLDOWN_MIN=30
ALERTA_SUPERADMIN_ACOES=OUVIDORIA_EXPORTAR_CSV,REINDEXAR_TODOS_SUCESSO,USUARIO_CRIAR_ADMIN_SUCESSO,FUNCIONARIO_INATIVAR_SUCESSO,FUNCIONARIO_REATIVAR_SUCESSO,FUNCIONARIO_EDITAR_SUCESSO,FUNCIONARIO_CADASTRAR_SERVIDOR_SUCESSO,FUNCIONARIO_CADASTRAR_TERCEIRIZADO_SUCESSO

SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587

SMTP_USER=sistema@empresa.com.br
SMTP_PASSWORD=troque-aqui

SMTP_USE_TLS=true
SMTP_USE_SSL=false

SMTP_TIMEOUT=10
